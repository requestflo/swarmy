# ───────────────────────────────────────────────────────────────────
# swarmy — environment template
# Copy to `.env` and fill in. `bun docker:up` provisions Postgres on :5678.
# ───────────────────────────────────────────────────────────────────

# Controller
NODE_ENV=development
PORT=3001

# Database (Postgres) — host port 5678 maps to container 5432 (see docker/docker-compose.yml)
DATABASE_URL=postgresql://swarmy:swarmy@localhost:5678/swarmy?schema=public

# Better Auth — generate a strong secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# Public URL the dashboard + agents use to reach the controller.
CONTROLLER_PUBLIC_URL=http://localhost:3001

# ───────────────────────────────────────────────────────────────────
# Agent (apps/agent) — set on each node, NOT on the controller
# ───────────────────────────────────────────────────────────────────
# wss in production. Dev points at the controller's /agent/ws endpoint.
AGENT_WS_URL=ws://localhost:3001/agent/ws
# Join token minted in the dashboard (Settings → Tokens). One-time or multi-use.
SWARMY_JOIN_TOKEN=
# Local Docker socket the agent reads (never exposed over the network).
DOCKER_SOCKET=/var/run/docker.sock
# Where the agent persists its node id + rotating session secret (mode 0600).
SWARMY_AGENT_STATE=~/.swarmy/agent.json
# Opt-in to remote `docker exec` (RCE-adjacent; off by default).
SWARMY_ALLOW_EXEC=false
