# ───────────────────────────────────────────────────────────────────
# swarmy — environment template
# Copy to `.env` and fill in. `bun docker:up` provisions Postgres on :5678.
# ───────────────────────────────────────────────────────────────────

# Controller
NODE_ENV=development
PORT=3001

# Data store — pick a driver (data-store-strategy epic):
#   SWARMY_DB_DRIVER=pglite    → embedded Postgres (WASM, in-process). LITE MODE.
#                                Zero dependencies: no docker:up, no DATABASE_URL.
#                                Optionally persist with SWARMY_DATA_DIR (else in-memory).
#   SWARMY_DB_DRIVER=postgres  → server Postgres over DATABASE_URL (default; back-compat).
#                                Covers swarmy-managed Postgres and bring-your-own/external.
# Lite first run needs NOTHING below — just set the driver:
# SWARMY_DB_DRIVER=pglite
# SWARMY_DATA_DIR=~/.swarmy/data/pg
SWARMY_DB_DRIVER=postgres

# Database (Postgres) — only required for SWARMY_DB_DRIVER=postgres.
# Host port 5678 maps to container 5432 (see docker/docker-compose.yml). If 5678 is
# taken locally, set SWARMY_DB_PORT to a free port (compose picks it up) and change
# the port in DATABASE_URL below to match.
SWARMY_DB_PORT=5678
DATABASE_URL=postgresql://swarmy:swarmy@localhost:5678/swarmy?schema=public

# Better Auth — generate a strong secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# Public URL the dashboard + agents use to reach the controller.
CONTROLLER_PUBLIC_URL=http://localhost:3001

# ───────────────────────────────────────────────────────────────────
# Agent (apps/agent) — set on each node, NOT on the controller
# ───────────────────────────────────────────────────────────────────
# wss in production. Dev points at the controller's /agent/ws endpoint.
AGENT_WS_URL=ws://localhost:3001/agent/ws
# Join token minted in the dashboard (Settings → Tokens). One-time or multi-use.
SWARMY_JOIN_TOKEN=
# Local Docker socket the agent reads (never exposed over the network).
DOCKER_SOCKET=/var/run/docker.sock
# Where the agent persists its node id + rotating session secret (mode 0600).
SWARMY_AGENT_STATE=~/.swarmy/agent.json
# Opt-in to remote `docker exec` (RCE-adjacent; off by default).
SWARMY_ALLOW_EXEC=false

# Credential vault — encrypts stored secrets (openssl rand -base64 32)
SWARMY_SECRET_KEY=
