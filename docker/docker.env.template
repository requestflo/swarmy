# Environment for running swarmy components in containers.
# Controller (apps/api) ----------------------------------------------
NODE_ENV=production
PORT=3021
# control.db + telemetry.db live here: mount a volume at this path.
SWARMY_DATA_DIR=/var/lib/swarmy/data
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=https://swarmy.example.com
CONTROLLER_PUBLIC_URL=https://swarmy.example.com

# Agent (apps/agent) — one per node -----------------------------------
AGENT_WS_URL=wss://swarmy.example.com/agent/ws
SWARMY_JOIN_TOKEN=
DOCKER_SOCKET=/var/run/docker.sock
SWARMY_AGENT_STATE=/var/lib/swarmy/agent.json
# Tri-state local overrides — leave unset to follow the node's dashboard toggles.
# SWARMY_ALLOW_EXEC=false vetoes container exec on this box (default: on).
# SWARMY_ALLOW_NODE_SHELL=false vetoes the host shell (default: off; needs the
# admin 'Host shell' toggle).
#SWARMY_ALLOW_EXEC=
#SWARMY_ALLOW_NODE_SHELL=
