# Environment for running swarmy components in containers.
# Controller (apps/api) ----------------------------------------------
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://swarmy:swarmy@postgres:5432/swarmy?schema=public
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=https://swarmy.example.com
CONTROLLER_PUBLIC_URL=https://swarmy.example.com

# Agent (apps/agent) — one per node -----------------------------------
AGENT_WS_URL=wss://swarmy.example.com/agent/ws
SWARMY_JOIN_TOKEN=
DOCKER_SOCKET=/var/run/docker.sock
SWARMY_AGENT_STATE=/var/lib/swarmy/agent.json
SWARMY_ALLOW_EXEC=false
