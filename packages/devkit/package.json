{
  "name": "@swarmy/devkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./check": {
      "types": "./src/check/index.ts",
      "import": "./src/check/index.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "import": "./src/mcp/index.ts"
    },
    "./testing": {
      "types": "./src/testing/fake-api.ts",
      "import": "./src/testing/fake-api.ts"
    }
  },
  "scripts": {
    "build": "echo '@swarmy/devkit resolves to src'",
