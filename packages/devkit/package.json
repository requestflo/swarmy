    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "@swarmy/app-config": "workspace:*",
    "yaml": "^2.6.1",
