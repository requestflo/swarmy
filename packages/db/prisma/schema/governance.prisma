// Governance singletons: exposure + guardrail config.

model ExposureConfig {
  id        String   @id @default(cuid())
  orgId     String   @unique
  rulesJson Json     @default("{}")
  enforce   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("exposure_config")
}

model GuardrailConfig {
  id                   String   @id @default(cuid())
  orgId                String   @unique
  rulesJson            Json     @default("{}")
  productionSafetyMode Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("guardrail_config")
}
