// Alerting / incidents / status pages: channels, rules, events, incidents, uptime.

enum NotificationChannelKind {
  EMAIL
  SLACK
  TEAMS
  WEBHOOK
  DISCORD
  TELEGRAM
  NTFY
  GOTIFY
}

enum AlertEventStatus {
  FIRING
  RESOLVED
}

/// What happened to an alert event's firing notification (owner decision Q10).
enum AlertNotifyState {
  /// Delivered (or no channel to deliver to).
  SENT
  /// Quiet hours: recorded, not sent yet. Sent once when quiet hours end if
  /// the event is still firing.
  HELD
  /// The rule was muted when it fired: recorded, not sent. Sent once after
  /// the mute ends if the event is still firing (a snooze, not a delete).
  MUTED
  /// Held or muted, then resolved before it could be sent: never sent.
  SKIPPED
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

model NotificationChannel {
  id        String                  @id @default(cuid())
  orgId     String
  name      String
  kind      NotificationChannelKind
  // Encrypted via the vault (SWARMY_SECRET_KEY). Never returned to clients.
  configEnc String?
  enabled   Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("notification_channel")
}

model AlertRule {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  // Signal key evaluated by the alert-evaluator worker (e.g. node-offline,
  // service-down, db-degraded, queue-depth, error-rate, cert-expiry,
  // disk-usage, crash-loop) or fired by a slice (build-failed, deploy-failed,
  // deploy-rolled-back, backup-failed).
  signal       String
  // What the rule is narrowed to (`AlertSelector` in @swarmy/core
  // alert-targets.ts): {} = any; {server} for server signals; {app, service?}
  // for app signals. Several rules may share a signal (Q10).
  selectorJson Json     @default("{}")
  threshold    Float?
  forSeconds   Int      @default(0)
  // NotificationChannel ids to notify (JSON array of strings).
  channelIds   Json     @default("[]")
  enabled      Boolean  @default(true)
  isDefault    Boolean  @default(false)
  /// Opt-out tombstone: the user deleted this DEFAULT rule. Kept (disabled,
  /// hidden from lists) so the default seed never re-creates it — the
  /// autoBackup `optedOutAt` pattern.
  optedOutAt   DateTime?
  /// "Mute for 1h": until this instant the rule still records events but
  /// sends no notifications and opens no incident. Null = not muted.
  mutedUntil   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events AlertEvent[]

  @@index([orgId, enabled])
  @@map("alert_rule")
}

model AlertEvent {
  id         String           @id @default(cuid())
  orgId      String
  ruleId     String?
  signal     String
  severity   String           @default("warning")
  // Resource key the event fired for (dedupe axis), e.g. `service:web` / `node:n1`.
  resource   String
  message    String
  status     AlertEventStatus @default(FIRING)
  // Whether the firing notification went out, is held (quiet hours) or muted.
  notify     AlertNotifyState @default(SENT)
  firedAt    DateTime         @default(now())
  resolvedAt DateTime?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rule AlertRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([orgId, status, firedAt])
  @@index([ruleId, resource, status])
  @@index([orgId, status, notify])
  @@map("alert_event")
}

/// Workspace quiet hours (owner decision Q10): one row per org. Between
/// `start` and `end` (HH:MM, wall clock in `timeZone`; start > end wraps past
/// midnight) warning notifications are held; critical ones still page while
/// `criticalPages`. Absent row = quiet hours off.
model AlertQuietHours {
  id            String   @id @default(cuid())
  orgId         String   @unique
  enabled       Boolean  @default(false)
  start         String   @default("22:00")
  end           String   @default("07:00")
  timeZone      String   @default("UTC")
  criticalPages Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("alert_quiet_hours")
}

/// Workspace cost budget (owner decision Q6): one row per org. The monthly
/// budget the `cost-budget` alert rule compares the projected month against
/// (the rule's threshold is the warn-at %), plus the weekly cost summary sent
/// through the alert channels. `lastWeeklyAt` makes the weekly send idempotent.
model CostBudget {
  id               String    @id @default(cuid())
  orgId            String    @unique
  /// Null = no budget (the weekly summary can still run).
  monthlyUsd       Float?
  weeklySummary    Boolean   @default(false)
  /// string[] of NotificationChannel ids; [] = every enabled channel.
  weeklyChannelIds Json      @default("[]")
  lastWeeklyAt     DateTime?
  updatedAt        DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("cost_budgets")
}

model Incident {
  id         String         @id @default(cuid())
  orgId      String
  title      String
  status     IncidentStatus @default(OPEN)
  severity   String         @default("major")
  summary    String?
  openedAt   DateTime       @default(now())
  resolvedAt DateTime?

  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events IncidentEvent[]

  @@index([orgId, status, openedAt])
  @@map("incident")
}

model IncidentEvent {
  id         String   @id @default(cuid())
  orgId      String
  incidentId String
  at         DateTime @default(now())
  kind       String
  message    String
  meta       Json     @default("{}")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  incident Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([incidentId, at])
  @@map("incident_event")
}

enum UptimeStatus {
  UP
  DEGRADED
  DOWN
}

model StatusPage {
  id             String   @id @default(cuid())
  orgId          String
  slug           String   @unique
  title          String
  // Stack this status page fronts (stack-scoped IA); null = org-wide/legacy.
  stackName      String?
  domain         String?
  componentsJson Json     @default("[]")
  showUptime     Boolean  @default(true)
  showIncidents  Boolean  @default(true)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  samples UptimeSample[]

  @@index([orgId])
  @@index([orgId, stackName])
  @@map("status_page")
}

// Sampled by the alert-evaluator worker; retention-pruned.
model UptimeSample {
  id           String       @id @default(cuid())
  orgId        String
  pageId       String
  componentKey String
  at           DateTime     @default(now())
  status       UptimeStatus @default(UP)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  page StatusPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([orgId, at])
  @@index([pageId, componentKey, at])
  @@map("uptime_sample")
}
