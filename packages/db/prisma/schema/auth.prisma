// Better Auth tables (User / Session / Account / Verification) + Organization / Member / Invitation.

model User {
  id            String   @id
  name          String
  // Always present (Better Auth requires it) but optional for people: an
  // account without email carries a reserved `*.swarmy.invalid` placeholder
  // (packages/auth/src/identity.ts). Never mail or display one.
  email         String   @unique
  emailVerified Boolean  @default(false)
  // Better Auth username plugin: sign in without email. Lowercased, unique.
  username        String?  @unique
  displayUsername String?
  image         String?
  // Better Auth twoFactor plugin: true once an authenticator app is verified.
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  twoFactors  TwoFactor[]
  accounts    Account[]
  members     Member[]
  joinTokens  JoinToken[]  @relation("JoinTokenCreator")
  auditLogs   AuditLog[]
  invitations Invitation[] @relation("InvitationInviter")
  apiKeys     ApiKey[]     @relation("ApiKeyCreator")

  @@map("user")
}

model Session {
  id                   String   @id
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  // swarmy MFA assurance (packages/auth/src/two-factor.ts): when this session
  // last passed a second factor (sign-in challenge or step-up), and whether it
  // still owes one (a magic-link sign-in by a 2FA-enrolled user).
  mfaVerifiedAt        DateTime?
  mfaPending           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

// Better Auth twoFactor plugin table. `secret` and `backupCodes` are encrypted
// with the auth secret by the plugin; never read or returned by swarmy code.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members       Member[]
  invitations   Invitation[]
  nodes         Node[]
  joinTokens    JoinToken[]
  stacks        Stack[]
  auditLogs     AuditLog[]

  snapshots           Snapshot[]
  ssoProviders        SsoProvider[]
  policies            Policy[]
  resourceGrants      ResourceGrant[]
  gitRepos            GitRepo[]
  gitConnections      GitConnection[]
  appPlans            AppPlan[]
  builds              Build[]
  registryConfig      RegistryConfig?
  registryCredentials RegistryCredential[]
  imageGcPolicy       ImageGcPolicy?
  apiKeys             ApiKey[]
  backupJobs          BackupJob[]
  restoreOperations   RestoreOperation[]
  offsiteMirrorRuns   OffsiteMirrorRun[]
  meshRoutes          MeshRoute[]
  terminalSessions    TerminalSession[]
  terminalPolicy      TerminalPolicy?
  securityPolicy      OrgSecurityPolicy?
  terminalApprovals   TerminalApproval[]
  vaultEntries        VaultEntry[]
  idempotencyKeys     IdempotencyKey[]
  oauthClients        OAuthClient[]
  webhookEndpoints    WebhookEndpoint[]
  webhookDeliveries   WebhookDelivery[]
  canvasLayout        CanvasLayout?
  platformConfig      PlatformConfig?
  errorProjects       ErrorProject[]
  studioQueries       StudioSavedQuery[]
  platformUpgradeRuns PlatformUpgradeRun[]
  emailConfig         EmailConfig?
  emailDomains        EmailDomain[]
  emailCredentials    EmailCredential[]
  emailTemplates      EmailTemplate[]
  emailSuppressions   EmailSuppression[]

  notificationChannels   NotificationChannel[]
  alertRules             AlertRule[]
  alertEvents            AlertEvent[]
  incidents              Incident[]
  incidentEvents         IncidentEvent[]
  statusPages            StatusPage[]
  uptimeSamples          UptimeSample[]
  scheduledJobs          ScheduledJob[]
  jobRuns                JobRun[]
  workflowDefs           WorkflowDef[]
  workflowRuns           WorkflowRun[]
  workflowStepRuns       WorkflowStepRun[]
  inboundEndpoints       InboundEndpoint[]
  inboundDeliveries      InboundDelivery[]
  releases               Release[]
  imageScans             ImageScan[]
  exposureConfig         ExposureConfig?
  guardrailConfig        GuardrailConfig?
  notificationConfig     NotificationConfig?
  notificationTemplates  NotificationTemplate[]
  notificationDeliveries NotificationDelivery[]
  aiProviderConfig       AiProviderConfig?
  aiVirtualKeys          AiVirtualKey[]
  aiUsage                AiUsage[]
  aiRequestLogs          AiRequestLog[]
  recoveryClaims         RecoveryClaim[]
  operationRuns          OperationRun[]

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String   @default("member")
  attributes     Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitation")
}
