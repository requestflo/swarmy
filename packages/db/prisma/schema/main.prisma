// swarmy control.db — Prisma 7 schema (SQLite via the in-repo bun:sqlite adapter).
// Multi-file schema (Prisma 6.7+ GA): models live in domain files in this folder;
// this file holds the generator + datasource. All files are combined at generate.

// swarmy control.db — Prisma 7 schema (SQLite via the in-repo bun:sqlite adapter).
generator client {
  provider     = "prisma-client"
  output       = "../../src/generated"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}
