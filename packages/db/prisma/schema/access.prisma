// Access control: auth providers, SSO, ABAC policies + resource grants.

model AuthProviderConfig {
  id              String   @id @default(cuid())
  orgId           String?
  type            String
  enabled         Boolean  @default(false)
  clientId        String?
  encryptedSecret String?
  scopes          Json     @default("[]")
  settings        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, type])
  @@map("auth_provider_config")
}

model SsoProvider {
  id              String   @id @default(cuid())
  orgId           String
  protocol        String
  providerId      String   @unique
  domain          String?
  issuer          String?
  clientId        String?
  encryptedSecret String?
  metadata        Json     @default("{}")
  mapping         Json     @default("{}")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([domain])
  @@map("sso_provider")
}

model Policy {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  effect      String
  source      String
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  isdefault   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, enabled])
  @@map("policy")
}

model ResourceGrant {
  id            String   @id @default(cuid())
  orgId         String
  principalType String
  principalId   String
  resourceType  String
  resourceId    String
  relation      String
  createdAt     DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([principalType, principalId, resourceType, resourceId, relation])
  @@index([orgId, resourceType, resourceId])
  @@map("resource_grant")
}

// Org-wide account-security policy (launch-blocker #7). "Require 2FA" is an
// enrolment requirement enforced in orgProcedure after a grace period; the
// terminal step-up window lives on TerminalPolicy.mfaMaxAgeMs.
model OrgSecurityPolicy {
  orgId         String    @id
  /// off | admins (owner+admin) | all
  require2fa    String    @default("off")
  /// Days a member has to enrol, counted from max(enforcedSince, joined).
  graceDays     Int       @default(7)
  /// When require2fa last went from off → on (the grace clock's start).
  enforcedSince DateTime?
  /// Members who only sign in via SSO/social are exempt: their IdP owns MFA.
  trustIdpMfa   Boolean   @default(true)
  updatedAt     DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("org_security_policy")
}

// A shareable, multi-use invite link (owner decision Q7). Whoever opens it and
// signs in joins the org with `role`; with `stackName` set they also get an
// `operator` ResourceGrant on that app. Only the sha-256 of the token is kept
// (`swi_<prefix>_<secret>`, shown once). `uses` is bumped by a compare-and-swap
// so a link can't be redeemed past `maxUses` (null = unlimited).
model InviteLink {
  id          String    @id @default(cuid())
  orgId       String
  tokenHash   String    @unique
  prefix      String
  role        String
  stackName   String?
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  createdById String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("InviteLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@map("invite_link")
}
