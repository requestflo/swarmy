// Mesh networking: direct-connect / people-access grants (access control).
// The driver/control-plane config lives in the org's swarm (swarm-kv
// `mesh/<orgId>`, plans/epic-docker-native-state.md P4). Peers are derived live
// (agent meshState + the control plane), never stored.

model MeshRoute {
  id              String    @id @default(cuid())
  orgId           String
  kind            String    @default("direct")
  targetServiceId String?
  targetStackId   String?
  cidr            String?
  port            Int?
  proto           String?
  principalType   String    @default("peer")
  principalId     String
  policyRef       String?
  expiresAt       DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("mesh_route")
}
