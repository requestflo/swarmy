// Mesh networking: driver config + direct-connect / people-access grants.
// Peers are derived live (agent meshState + the control plane), never stored.

enum MeshDriver {
  NETBIRD
  HEADSCALE
  TAILSCALE
  WIREGUARD
  NONE
}

model MeshConfig {
  id            String     @id @default(cuid())
  orgId         String     @unique
  driver        MeshDriver @default(NONE)
  enabled       Boolean    @default(false)
  managementUrl String?
  controlPlane  Json       @default("{}")
  settings      Json       @default("{}")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("mesh_config")
}

model MeshRoute {
  id              String    @id @default(cuid())
  orgId           String
  kind            String    @default("direct")
  targetServiceId String?
  targetStackId   String?
  cidr            String?
  port            Int?
  proto           String?
  principalType   String    @default("peer")
  principalId     String
  policyRef       String?
  expiresAt       DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("mesh_route")
}
