// Git / CI / registry: repos, builds, registry config, image GC, image scans.

enum GitProviderKind {
  GITHUB
  GITLAB
  GITEA
  GENERIC
}

enum BuildStatus {
  QUEUED
  BUILDING
  PUSHING
  SUCCEEDED
  FAILED
  CANCELED
}

model GitRepo {
  id         String          @id @default(cuid())
  orgId      String
  provider   GitProviderKind @default(GITHUB)
  url        String
  branch     String          @default("main")
  tokenEnc         String?
  webhookSecretEnc String?
  autodeploy Boolean         @default(false)
  serviceId  String?
  // PR preview environments (platform buildout, D4):
  // { enable, baseDomain, ttlHours, teardownOnClose }. Preview stacks themselves
  // are Docker-truth (`swarmy.preview.*` stack labels) — this is repo INPUT config.
  previewsJson Json?
  // ── git-apps (Phase 2): provider connection + app binding ──
  // How swarmy authenticates to this repo (GitHub App installation / GitLab
  // OAuth / generic). Null = legacy per-repo `tokenEnc` / public repo.
  connectionId    String?
  // Provider's stable repo id (GitHub repo id / GitLab project id).
  externalRepoId  String?
  // owner/name (GitHub) or group/…/name (GitLab) — for API feedback calls.
  fullName        String?
  // Path of the swarmy.yaml this binding applies (monorepo: many per repo).
  configPath      String  @default("swarmy.yaml")
  // The app (stack) name the swarmy.yaml declares — set on first plan.
  appName         String?
  // Last commit whose plan fully applied (changed-path base for the next push).
  lastAppliedSha  String?
  // Generic git over SSH: swarmy-generated ed25519 deploy key (private half
  // vault-encrypted, never returned; public half shown to paste into the host).
  deployKeyEnc    String?
  deployKeyPublic String?
  // git-apps P3: every change waits for a human (not only destructive ones).
  requireApproval Boolean @default(false)
  // Opt-in: drift on git-owned fields is re-applied automatically (default:
  // report only). Destructive steps still wait for a human either way.
  enforceDrift    Boolean @default(false)
  // Branches the swarmy.yaml's `environments:` track (webhook/poll routing): string[] as JSON.
  envBranches     Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connection GitConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  builds     Build[]
  appPlans   AppPlan[]

  @@unique([orgId, url, branch, configPath])
  @@index([orgId])
  @@index([connectionId])
  @@index([externalRepoId])
  @@map("git_repo")
}

/// The controller's own GitHub App, registered in one click via the manifest
/// flow (one per controller instance + GitHub host; no swarmy cloud). Every
/// secret is vault-encrypted and never returned to a client. Installations of
/// it are bound to swarmy orgs as `GitConnection` rows.
model GitHubApp {
  id               String   @id @default(cuid())
  webBase          String   @default("https://github.com")
  appId            Int
  slug             String
  name             String
  htmlUrl          String
  ownerLogin       String?
  clientId         String
  clientSecretEnc  String
  privateKeyEnc    String
  webhookSecretEnc String
  // The org whose admin registered it (audit context only — not a scope).
  createdByOrgId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  connections GitConnection[]

  @@unique([webBase, appId])
  @@map("github_app")
}

/// An org's authenticated link to a git provider: a GitHub App installation,
/// a GitLab OAuth grant / access token, a Gitea token, or a generic PAT.
/// Tokens are vault-encrypted; GitHub installation tokens are minted JIT and
/// never stored.
model GitConnection {
  id              String          @id @default(cuid())
  orgId           String
  kind            GitProviderKind
  displayName     String
  // Provider web base (https://github.com, https://gitlab.example.com, …).
  baseUrl         String
  // GITHUB: the App + installation this connection is.
  githubAppId     String?
  installationId  String?
  account         String?
  // GITLAB/GITEA OAuth application (per org) + the grant's tokens.
  clientId        String?
  clientSecretEnc String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  // HTTPS username paired with a stored token (oauth2 for GitLab).
  tokenUser       String?
  // pending = waiting for the OAuth round-trip; active = usable.
  status          String          @default("active")
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  githubApp GitHubApp?   @relation(fields: [githubAppId], references: [id], onDelete: Cascade)
  repos     GitRepo[]

  @@unique([githubAppId, installationId])
  @@index([orgId])
  @@map("git_connection")
}

model Build {
  id         String      @id @default(cuid())
  orgId      String
  repoId     String
  commit     String?
  status     BuildStatus @default(QUEUED)
  image      String?
  logsRef    String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime    @default(now())
  /// Which builder ran: "dockerfile" | "railpack" (history; null = before zero-config builds).
  builder    String?
  /// What Railpack detected (JSON: providers, versions, start command) — history for the UI.
  detectJson String?
  /// Registry build-cache ref this build exported to (the cache GC's age source).
  cacheRef   String?
  /// BuildKit steps served from cache (warm-build signal).
  cachedSteps Int?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repo GitRepo      @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([repoId, startedAt])
  @@map("build")
}

enum ImageScanStatus {
  PASSED
  FAILED
  ERROR
}

model ImageScan {
  id            String          @id @default(cuid())
  orgId         String
  imageRef      String
  digest        String?
  scanner       String          @default("trivy")
  criticalCount Int             @default(0)
  highCount     Int             @default(0)
  mediumCount   Int             @default(0)
  lowCount      Int             @default(0)
  reportJson    Json            @default("{}")
  status        ImageScanStatus @default(PASSED)
  scannedAt     DateTime        @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, scannedAt])
  @@index([orgId, imageRef])
  @@index([digest])
  @@map("image_scan")
}

// Third-party registry credentials (GHCR, Docker Hub, GitLab, ECR/GCR/ACR, any
// `host[/path]`). Org-scoped, matched to an image by the LONGEST `prefix`, and
// injected JIT on every pull/build by the hub dispatch decorator
// (registry-auth.ts). `secretEnc` is vault-encrypted (SWARMY_SECRET_KEY) and
// NEVER returned to a client — write-only UX (set / rotate / delete).
model RegistryCredential {
  id              String    @id @default(cuid())
  orgId           String
  /** Normalised `host[/path]` (docker.io aliases folded; no scheme, no trailing slash). */
  prefix          String
  /** UI hint only: ghcr | dockerhub | gitlab | ecr | gcr | acr | generic. */
  provider        String    @default("generic")
  label           String?
  username        String
  secretEnc       String
  lastTestedAt    DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, prefix])
  @@index([orgId])
  @@map("registry_credential")
}

/// One swarmy.yaml plan for one app environment at one commit (git-apps P3):
/// queryable HISTORY of what swarmy decided and did — who confirmed which
/// held step, what failed. `ledgerJson` is the cumulative "what swarmy has
/// applied for this app environment" after this plan (the diff base for the
/// next one). What RUNS is still Docker truth; this never shadows it.
model AppPlan {
  id            String    @id @default(cuid())
  orgId         String
  repoId        String
  // production | <environment name> | preview
  environment   String
  stack         String
  sha           String
  // push | pr | manual | poll | drift | confirm
  trigger       String
  prNumber      Int       @default(0)
  // planned | applying | applied | partial | needs-confirmation | blocked | failed | superseded | invalid
  status        String
  planJson      Json?
  desiredJson   Json?
  issuesJson    Json?
  ledgerJson    Json?
  // Per-action outcomes: { [actionId]: { status, message?, at } }
  resultsJson   Json?
  error         String?
  confirmedIds  Json?
  confirmedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  appliedAt     DateTime?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repo GitRepo      @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, environment, sha, trigger, prNumber])
  @@index([orgId, createdAt])
  @@index([repoId, environment, createdAt])
  @@map("app_plan")
}
