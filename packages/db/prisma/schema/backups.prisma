// Backups / DR history: volume snapshots, controller snapshots, backup jobs,
// restores and off-site mirror runs. The config they belong to — targets,
// schedules, the off-site mirror, the controller-backup settings — lives in
// the org's swarm (swarm-kv, plans/epic-docker-native-state.md P4 slice 3), so
// `targetId` / `scheduleId` / `mirrorId` here are plain strings.

enum SnapshotStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PRUNED
}

model Snapshot {
  id         String         @id @default(cuid())
  orgId      String
  targetId   String
  volume     String
  status     SnapshotStatus @default(RUNNING)
  resticId   String?
  sizeBytes  BigInt?
  error      String?
  hostNodeId String?
  startedAt  DateTime       @default(now())
  finishedAt DateTime?

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([volume, startedAt])
  @@index([targetId])
  @@map("snapshot")
}

model ControllerSnapshot {
  id               String         @id @default(cuid())
  targetId         String
  resticSnapshotId String?
  sizeBytes        BigInt?
  durationMs       Int?
  manifestJson     Json?
  status           SnapshotStatus @default(RUNNING)
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?
  error            String?

  @@index([startedAt])
  @@index([targetId])
  @@map("controller_snapshot")
}

enum BackupJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum RestoreStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// The replicated object store (StorageCluster) and per-bucket reachability
// (BucketAccess) live in the org's swarm (swarm-kv storage/<orgId> and
// bkt-acl/<orgId>, plans/epic-docker-native-state.md P4 slice 2).

model BackupJob {
  id         String          @id @default(cuid())
  orgId      String
  scheduleId String?
  snapshotId String?
  status     BackupJobStatus @default(RUNNING)
  error      String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([scheduleId, startedAt])
  @@map("backup_job")
}

model RestoreOperation {
  id            String        @id @default(cuid())
  orgId         String
  snapshotId    String
  targetVolume  String
  targetNodeId  String?
  conflict      String        @default("overwrite")
  status        RestoreStatus @default(QUEUED)
  reason        String        @default("manual")
  bytesRestored BigInt?
  error         String?
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([orgId, snapshotId, status])
  @@map("restore_operation")
}

/// One mirror (store → off-site) or restore (off-site → store) run.
model OffsiteMirrorRun {
  id            String          @id @default(cuid())
  orgId         String
  mirrorId      String
  /// "mirror" | "restore"
  direction     String          @default("mirror")
  /// "schedule" | "manual"
  trigger       String          @default("schedule")
  status        BackupJobStatus @default(RUNNING)
  objectsCopied Int             @default(0)
  bytesCopied   BigInt          @default(0)
  deletes       Int             @default(0)
  errorCount    Int             @default(0)
  /// Per-bucket outcome: [{ bucket, objects, bytes, deletes, errors, exitCode }].
  buckets       Json            @default("[]")
  error         String?
  hostNodeId    String?
  actorId       String?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?

  org    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([mirrorId, startedAt])
  @@index([status])
  @@map("offsite_mirror_run")
}
