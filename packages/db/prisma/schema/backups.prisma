// Backups / DR: targets, snapshots, controller backup, replicated store (Garage), CSI volumes, schedules.

enum BackupTargetKind {
  S3
  NODE
}

enum SnapshotStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PRUNED
}

model BackupTarget {
  id                String           @id @default(cuid())
  orgId             String
  name              String
  kind              BackupTargetKind @default(S3)
  endpoint          String?
  bucket            String
  prefix            String?
  region            String?
  // Encrypted via the vault (SWARMY_SECRET_KEY). Never returned to clients.
  credentialRef     String?
  secretKeyRef      String?
  resticPasswordRef String
  enabled           Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  org                 Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  snapshots           Snapshot[]
  schedules           BackupSchedule[]
  controllerConfigs   ControllerBackupConfig[]
  controllerSnapshots ControllerSnapshot[]     @relation("ControllerSnapshots")
  offsiteMirrors      OffsiteMirror[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("backup_target")
}

model Snapshot {
  id         String         @id @default(cuid())
  orgId      String
  targetId   String
  volume     String
  status     SnapshotStatus @default(RUNNING)
  resticId   String?
  sizeBytes  BigInt?
  error      String?        @db.Text
  hostNodeId String?
  startedAt  DateTime       @default(now())
  finishedAt DateTime?

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  target BackupTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([volume, startedAt])
  @@index([targetId])
  @@map("snapshot")
}

model ControllerBackupConfig {
  id                    String    @id @default("controller")
  targetId              String?
  enabled               Boolean   @default(false)
  schedule              String    @default("0 3 * * *")
  retention             Json      @default("{\"keepDaily\":7,\"keepWeekly\":4,\"keepMonthly\":3}")
  restorePassphraseRef  String?
  restorePassphraseHint String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  target BackupTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)

  @@map("controller_backup_config")
}

model ControllerSnapshot {
  id               String         @id @default(cuid())
  targetId         String
  resticSnapshotId String?
  sizeBytes        BigInt?
  durationMs       Int?
  manifestJson     Json?
  status           SnapshotStatus @default(RUNNING)
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?
  error            String?        @db.Text

  target BackupTarget @relation("ControllerSnapshots", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([startedAt])
  @@index([targetId])
  @@map("controller_snapshot")
}

enum StorageClusterDriver {
  GARAGE
  MINIO
  NONE
}

enum BackupJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum RestoreStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model StorageCluster {
  id                String               @id @default(cuid())
  orgId             String               @unique
  driver            StorageClusterDriver @default(NONE)
  enabled           Boolean              @default(false)
  replicationFactor Int                  @default(3)
  region            String               @default("swarmy")
  memberNodeIds     Json                 @default("[]")
  layout            Json                 @default("{}")
  rpcSecretRef      String?
  adminTokenRef     String?
  accessKeyRef      String?
  secretKeyRef      String?
  /// Public S3 hostname the edges serve for `PUBLIC` buckets (null = derived
  /// from the dashboard domain: swarmy.x → s3.x).
  publicS3Domain    String?
  /// Garage image this store RUNS (null = legacy v1.0.1, the pre-v2 default).
  /// Changed only by an engine upgrade — never by a redeploy picking up a new
  /// default — because a Garage major is not a rolling upgrade.
  engineImage       String?
  /// In-flight / last engine upgrade run (resumable state), null = never run.
  engineUpgrade     Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("storage_cluster")
}

/// Who can reach one bucket's S3 API. Enforced at the Caddy edge (a bucket
/// path allowlist in front of Garage); Garage still demands SigV4 keys or a
/// presigned signature, so PUBLIC means reachable, not anonymous. No row =
/// INTERNAL (in-cluster only), the default.
model BucketAccess {
  id         String   @id @default(cuid())
  orgId      String
  /// Garage bucket id (stable) + its global alias at the time it was set.
  bucketId   String
  bucketName String
  /// INTERNAL | MESH | PUBLIC
  mode       String   @default("INTERNAL")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orgId, bucketId])
  @@index([orgId])
  @@map("bucket_access")
}

model BackupSchedule {
  id        String    @id @default(cuid())
  orgId     String
  targetId  String
  volume    String
  nodeId    String?
  every     Int
  unit      String
  paused    Boolean   @default(false)
  /// Created by swarmy's default-on DB backups (not a user) — the UI badges it
  /// "Auto". A user editing/replacing it takes ownership.
  auto          Boolean   @default(false)
  /// Retention window (days) this schedule prunes to when the stack has no
  /// `swarmy.backup.retentionDays` label (the stack label, when set, wins).
  retentionDays Int?
  /// Interval anchor (defaults to createdAt) — auto schedules stagger their
  /// nightly slot within 02:00–04:59 UTC.
  anchorAt      DateTime?
  /// Opt-out tombstone: the user removed an auto schedule. Never runs, hidden
  /// from lists, and stops the auto-backup loop re-creating it.
  optedOutAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  target BackupTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  jobs   BackupJob[]

  @@index([orgId])
  @@index([orgId, volume])
  @@index([paused])
  @@map("backup_schedule")
}

model BackupJob {
  id         String          @id @default(cuid())
  orgId      String
  scheduleId String?
  snapshotId String?
  status     BackupJobStatus @default(RUNNING)
  error      String?         @db.Text
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  schedule BackupSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([scheduleId, startedAt])
  @@map("backup_job")
}

model RestoreOperation {
  id            String        @id @default(cuid())
  orgId         String
  snapshotId    String
  targetVolume  String
  targetNodeId  String?
  conflict      String        @default("overwrite")
  status        RestoreStatus @default(QUEUED)
  reason        String        @default("manual")
  bytesRestored BigInt?
  error         String?       @db.Text
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([orgId, snapshotId, status])
  @@map("restore_operation")
}

/// Off-site mirror of the org's Garage object store (every bucket or a chosen
/// list) into an S3 `BackupTarget` — swarmy config, like the targets it points
/// at. One per org. The mirror's own Garage key is controller-held, encrypted.
model OffsiteMirror {
  id                 String    @id @default(cuid())
  orgId              String    @unique
  targetId           String
  /// true = mirror every bucket in the store; false = only `buckets`.
  allBuckets         Boolean   @default(true)
  buckets            Json      @default("[]")
  /// Path under the destination bucket the mirror writes into.
  prefix             String    @default("swarmy-mirror")
  everyMinutes       Int       @default(60)
  /// "copy" never deletes off-site; "sync" propagates deletes after graceDays.
  mode               String    @default("copy")
  graceDays          Int       @default(7)
  enabled            Boolean   @default(true)
  /// Encrypted (vault) Garage key the rclone one-shot reads the store with.
  sourceAccessKeyRef String?
  sourceSecretKeyRef String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org    Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  target BackupTarget       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  runs   OffsiteMirrorRun[]

  @@map("offsite_mirror")
}

/// One mirror (store → off-site) or restore (off-site → store) run.
model OffsiteMirrorRun {
  id            String          @id @default(cuid())
  orgId         String
  mirrorId      String
  /// "mirror" | "restore"
  direction     String          @default("mirror")
  /// "schedule" | "manual"
  trigger       String          @default("schedule")
  status        BackupJobStatus @default(RUNNING)
  objectsCopied Int             @default(0)
  bytesCopied   BigInt          @default(0)
  deletes       Int             @default(0)
  errorCount    Int             @default(0)
  /// Per-bucket outcome: [{ bucket, objects, bytes, deletes, errors, exitCode }].
  buckets       Json            @default("[]")
  error         String?         @db.Text
  hostNodeId    String?
  actorId       String?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?

  org    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  mirror OffsiteMirror @relation(fields: [mirrorId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([mirrorId, startedAt])
  @@index([status])
  @@map("offsite_mirror_run")
}
