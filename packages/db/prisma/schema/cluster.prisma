// Cluster identity: nodes, join tokens, stacks, metric samples, audit log, vault entries, canvas layout.

enum NodeRole {
  MANAGER
  WORKER
}


// Node is now an ENROLLMENT/IDENTITY record only — role/status/labels/resources/
// version/lastSeen are Docker-truth and live in the in-memory hub (epic #6 rip-out).
// What stays: identity + the per-node reconnect credential (auth).
model Node {
  id                String   @id @default(cuid())
  orgId             String
  name              String
  hostname          String
  // Per-node reconnect credential (hashed). Bump version to revoke.
  sessionSecretHash String?
  sessionVersion    Int      @default(1)
  joinTokenId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  joinToken      JoinToken?      @relation(fields: [joinTokenId], references: [id], onDelete: SetNull)
  recoveryClaims RecoveryClaim[]

  @@unique([orgId, name])
  @@map("node")
}

// Recovery beacon (self-healing epic): a node that lost every credential
// (session file gone AND its env-file token revoked) posts a claim; the
// operator approves it in the dashboard after verifying the fingerprint the
// machine prints. Approval mints a fresh session credential, stored encrypted
// for ONE delivery to whoever presents the claim secret, then wiped.
model RecoveryClaim {
  id        String @id @default(cuid())
  orgId     String
  nodeId    String?
  hostname  String
  // sha256(claimSecret): the agent proves claim continuity on every poll.
  claimHash String @unique
  // Short human code derived from claimHash — shown on the machine AND in the
  // dashboard; the operator matches them before approving (SSH-key model).
  fingerprint String
  status      String    @default("pending") // pending | approved | denied | delivered | expired
  // encryptSecret(JSON{nodeId,sessionSecret,sessionVersion}) — set on approve,
  // wiped at delivery.
  credentialEnc String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  resolvedAt    DateTime?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  node Node?        @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([hostname])
  @@map("recovery_claim")
}

model JoinToken {
  id          String    @id @default(cuid())
  orgId       String
  tokenHash   String    @unique
  tokenPrefix String
  label       String?
  maxUses     Int?
  uses        Int       @default(0)
  // node-onboarding P2: preferred swarm role for nodes minted from this token.
  roleHint    NodeRole?
  // WS7 install profiles: label bundle stamped onto nodes enrolled with this
  // token — 'edge' | 'storage' | 'database' | 'private-mesh' (see
  // NODE_PROFILE_VALUES in @swarmy/core). Null = default (no bundle).
  profile     String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("JoinTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)
  nodes     Node[]

  @@index([orgId])
  @@index([tokenPrefix])
  @@map("join_token")
}

// Service + Deployment models removed (epic #6): live services are Docker-truth in
// the hub; deploy status is synthesized from live convergence. Stack is trimmed to
// the user's compose CONFIG; its live status/services derive from stack-namespace labels.
model Stack {
  id               String         @id @default(cuid())
  orgId            String
  name             String
  composeSource    String
  ingressDriver    IngressDriver?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
  @@map("stack")
}


model AuditLog {
  id         Int      @id @default(autoincrement())
  orgId      String
  actorId    String?
  actorType  String   @default("user")
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  ts         DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, ts])
  @@index([targetType, targetId])
  @@map("audit_log")
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  orgId        String
  key          String
  method       String
  path         String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@map("idempotency_key")
}

// Small vault-encrypted values that must survive while the swarm itself is
// unreadable, so they can't be derived from Docker. Today: the opt-in swarm
// autolock unlock key escrow (`swarm.unlockKey`), needed exactly when the swarm
// is locked. Swarm id, manager address and join tokens are NOT here: they are
// read live from a manager (`docker info` / `swarm join-token -q`).
model VaultEntry {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  // encryptSecret(...) ciphertext. Never plaintext, never returned to clients.
  valueEnc  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@map("vault_entry")
}

model CanvasLayout {
  orgId     String   @id
  // serviceId/stackId → { x, y } persisted node positions (drag = visual only).
  positions Json     @default("{}")
  // last { x, y, zoom } viewport so the canvas reopens where the user left it.
  viewport  Json?
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("canvas_layout")
}
