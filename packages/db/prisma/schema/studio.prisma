// Database studio (plans/epic-developer-platform.md §3). The DB holds only
// swarmy's own config: the queries people SAVE per app (stack). Which databases
// exist is live Docker truth; query history is the `studio.query` audit rows
// (statement, user, duration, rows — never result values). No other state.
//
// Portable column shapes only (SQLite control.db): no db-specific attributes,
// no arrays, no autoincrement.

/// A named query saved on an app, shared with everyone in the org who can open it.
model StudioSavedQuery {
  id          String   @id @default(cuid())
  orgId       String
  /// The app / Docker stack namespace.
  stack       String
  /// The database it was written for: a managed cluster or compose service name. Null = any database of the app.
  target      String?
  /// "postgres" | "mysql" | "mariadb" | "mongo" | "redis" | "valkey"
  engine      String
  name        String
  statement   String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, stack, name])
  @@index([orgId, stack])
  @@map("studio_saved_query")
}
