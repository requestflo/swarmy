// swarmy — Prisma 7 schema (pg driver adapter, ESM client, no engine binary).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────── enums ──

enum NodeRole {
  MANAGER
  WORKER
}

// NodeStatus/ServiceStatus/StackStatus/DeploymentPhase/DeploymentTargetType removed
// with the Service/Deployment models + Node/Stack status columns (epic #6). NodeRole
// stays (still used by JoinToken.roleHint).

enum IngressDriver {
  CADDY
  TRAEFIK
  NONE
  CLOUDFLARE_TUNNEL
  NGINX
  HAPROXY
}

enum BackupTargetKind {
  S3
  NODE
}

enum SnapshotStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PRUNED
}

enum MetricScope {
  NODE
  CONTAINER
}

// ──────────────────────────────────────────── Better Auth tables ──
// Field/column names follow Better Auth's required schema. Ids are
// String with no @default — Better Auth supplies them.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  joinTokens  JoinToken[]  @relation("JoinTokenCreator")
  auditLogs   AuditLog[]
  invitations Invitation[] @relation("InvitationInviter")
  apiKeys     ApiKey[]     @relation("ApiKeyCreator")

  @@map("user")
}

model Session {
  id                   String   @id
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  members       Member[]
  invitations   Invitation[]
  nodes         Node[]
  joinTokens    JoinToken[]
  stacks        Stack[]
  ingressConfig IngressConfig?
  auditLogs     AuditLog[]
  metricSamples MetricSample[]

  backupTargets       BackupTarget[]
  snapshots           Snapshot[]
  observabilityConfig ObservabilityConfig?
  observabilityStore  ObservabilityStoreState[]
  meshConfig          MeshConfig?
  meshPeers           MeshPeer[]
  ssoProviders        SsoProvider[]
  policies            Policy[]
  resourceGrants      ResourceGrant[]
  gitRepos            GitRepo[]
  builds              Build[]
  registryConfig      RegistryConfig?
  imageGcPolicy       ImageGcPolicy?
  geoDnsConfig        GeoDnsConfig?
  dnsRecords          DnsRecord[]
  apiKeys             ApiKey[]
  storageCluster      StorageCluster?
  clusterVolumes      ClusterVolume[]
  backupSchedules     BackupSchedule[]
  backupJobs          BackupJob[]
  restoreOperations   RestoreOperation[]
  meshRoutes          MeshRoute[]
  meshAcls            MeshAcl[]
  tunnels             Tunnel[]
  terminalSessions    TerminalSession[]
  terminalPolicy      TerminalPolicy?
  terminalApprovals   TerminalApproval[]
  swarmConfig         SwarmConfig?
  idempotencyKeys     IdempotencyKey[]
  oauthClients        OAuthClient[]
  webhookEndpoints    WebhookEndpoint[]
  webhookDeliveries   WebhookDelivery[]
  canvasLayout        CanvasLayout?

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String   @default("member")
  attributes     Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitation")
}

// ───────────────────────────────────────────────── domain models ──

// Node is now an ENROLLMENT/IDENTITY record only — role/status/labels/resources/
// version/lastSeen are Docker-truth and live in the in-memory hub (epic #6 rip-out).
// What stays: identity + the per-node reconnect credential (auth).
model Node {
  id                String   @id @default(cuid())
  orgId             String
  name              String
  hostname          String
  // Per-node reconnect credential (hashed). Bump version to revoke.
  sessionSecretHash String?
  sessionVersion    Int      @default(1)
  joinTokenId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  joinToken     JoinToken?     @relation(fields: [joinTokenId], references: [id], onDelete: SetNull)
  metricSamples MetricSample[]

  @@unique([orgId, name])
  @@map("node")
}

model JoinToken {
  id          String    @id @default(cuid())
  orgId       String
  tokenHash   String    @unique
  tokenPrefix String
  label       String?
  maxUses     Int?
  uses        Int       @default(0)
  // node-onboarding P2: preferred swarm role for nodes minted from this token.
  roleHint    NodeRole?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("JoinTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)
  nodes     Node[]

  @@index([orgId])
  @@index([tokenPrefix])
  @@map("join_token")
}

// Service + Deployment models removed (epic #6): live services are Docker-truth in
// the hub; deploy status is synthesized from live convergence. Stack is trimmed to
// the user's compose CONFIG; its live status/services derive from stack-namespace labels.
model Stack {
  id               String         @id @default(cuid())
  orgId            String
  name             String
  composeSource    String         @db.Text
  ingressDriver    IngressDriver?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
  @@map("stack")
}

model MetricSample {
  id             BigInt      @id @default(autoincrement())
  orgId          String
  nodeId         String
  scope          MetricScope
  containerId    String?
  serviceId      String?
  cpuPercent     Float
  memUsedBytes   BigInt
  memTotalBytes  BigInt
  netRxBytes     BigInt
  netTxBytes     BigInt
  diskUsedBytes  BigInt
  diskTotalBytes BigInt
  ts             DateTime    @db.Timestamptz(3)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  node Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, ts])
  @@index([scope, containerId, ts])
  @@index([orgId, ts])
  @@map("metric_sample")
}

model IngressConfig {
  id        String        @id @default(cuid())
  orgId     String        @unique
  driver    IngressDriver @default(NONE)
  enabled   Boolean       @default(false)
  settings  Json          @default("{}")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("ingress_config")
}

// Domain model removed — per-service ingress routing now lives on the
// swarmy.ingress.routes service label (Docker-truth). Org-level ingress config
// (driver default, Caddy HA, tunnel) stays in IngressConfig.

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  orgId      String
  actorId    String?
  actorType  String   @default("user")
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  ts         DateTime @default(now()) @db.Timestamptz(3)

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, ts])
  @@index([targetType, targetId])
  @@map("audit_log")
}

// ───────────────────────────────────────────── volumes / DR ──

model BackupTarget {
  id                String           @id @default(cuid())
  orgId             String
  name              String
  kind              BackupTargetKind @default(S3)
  endpoint          String?
  bucket            String
  prefix            String?
  region            String?
  // Encrypted via the vault (SWARMY_SECRET_KEY). Never returned to clients.
  credentialRef     String?
  secretKeyRef      String?
  resticPasswordRef String
  enabled           Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  org                 Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  snapshots           Snapshot[]
  schedules           BackupSchedule[]
  controllerConfigs   ControllerBackupConfig[]
  controllerSnapshots ControllerSnapshot[]     @relation("ControllerSnapshots")

  @@unique([orgId, name])
  @@index([orgId])
  @@map("backup_target")
}

model Snapshot {
  id         String         @id @default(cuid())
  orgId      String
  targetId   String
  volume     String
  status     SnapshotStatus @default(RUNNING)
  resticId   String?
  sizeBytes  BigInt?
  error      String?        @db.Text
  hostNodeId String?
  startedAt  DateTime       @default(now())
  finishedAt DateTime?

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  target BackupTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([volume, startedAt])
  @@index([targetId])
  @@map("snapshot")
}

// ───────────────────────────────────────────── observability ──

model ObservabilityConfig {
  id              String   @id @default(cuid())
  orgId           String   @unique
  enabled         Boolean  @default(false)
  clickhouseDsn   String?  @db.Text
  collectorStatus String   @default("OFFLINE")
  retentionDays   Int      @default(7)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("observability_config")
}

model ObservabilityStoreState {
  id            String   @id @default(cuid())
  orgId         String   @unique
  nodeId        String?
  status        String   @default("UNKNOWN")
  reachable     Boolean  @default(false)
  diskUsedBytes BigInt   @default(0)
  lastCheckedAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("observability_store_state")
}

// ───────────────────────────────────────────── mesh networking ──

enum MeshDriver {
  NETBIRD
  HEADSCALE
  TAILSCALE
  WIREGUARD
  NONE
}

model MeshConfig {
  id            String     @id @default(cuid())
  orgId         String     @unique
  driver        MeshDriver @default(NONE)
  enabled       Boolean    @default(false)
  managementUrl String?
  controlPlane  Json       @default("{}")
  settings      Json       @default("{}")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("mesh_config")
}

model MeshPeer {
  id        String    @id @default(cuid())
  orgId     String
  nodeId    String    @unique
  driver    String    @default("NONE")
  peerId    String?
  meshIp    String?
  status    String    @default("ENROLLING")
  lastSeen  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("mesh_peer")
}

// ───────────────────────────────────────────── auth providers / ABAC ──

model AuthProviderConfig {
  id              String   @id @default(cuid())
  orgId           String?
  type            String
  enabled         Boolean  @default(false)
  clientId        String?
  encryptedSecret String?  @db.Text
  scopes          Json     @default("[]")
  settings        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, type])
  @@map("auth_provider_config")
}

model SsoProvider {
  id              String   @id @default(cuid())
  orgId           String
  protocol        String
  providerId      String   @unique
  domain          String?
  issuer          String?
  clientId        String?
  encryptedSecret String?  @db.Text
  metadata        Json     @default("{}")
  mapping         Json     @default("{}")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([domain])
  @@map("sso_provider")
}

model Policy {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  effect      String
  source      String   @db.Text
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  isdefault   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, enabled])
  @@map("policy")
}

model ResourceGrant {
  id            String   @id @default(cuid())
  orgId         String
  principalType String
  principalId   String
  resourceType  String
  resourceId    String
  relation      String
  createdAt     DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([principalType, principalId, resourceType, resourceId, relation])
  @@index([orgId, resourceType, resourceId])
  @@map("resource_grant")
}

// ───────────────────────────────────────────── git / CI / registry ──

enum GitProviderKind {
  GITHUB
  GITLAB
}

enum BuildStatus {
  QUEUED
  BUILDING
  PUSHING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ImageGcMode {
  ON_HEALTHCHECK
  AGE_DAYS
}

model GitRepo {
  id         String          @id @default(cuid())
  orgId      String
  provider   GitProviderKind @default(GITHUB)
  url        String
  branch     String          @default("main")
  tokenEnc         String?
  webhookSecretEnc String?
  autodeploy Boolean         @default(false)
  serviceId  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  builds Build[]

  @@unique([orgId, url])
  @@index([orgId])
  @@map("git_repo")
}

model Build {
  id         String      @id @default(cuid())
  orgId      String
  repoId     String
  commit     String?
  status     BuildStatus @default(QUEUED)
  image      String?
  logsRef    String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime    @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repo GitRepo      @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([repoId, startedAt])
  @@map("build")
}

model RegistryConfig {
  id             String   @id @default(cuid())
  orgId          String   @unique
  enabled        Boolean  @default(false)
  host           String?
  credentialsEnc String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("registry_config")
}

model ImageGcPolicy {
  id        String      @id @default(cuid())
  orgId     String      @unique
  mode      ImageGcMode @default(ON_HEALTHCHECK)
  keepProd  Boolean     @default(true)
  days      Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("image_gc_policy")
}

// ───────────────────────────────────────────── geo-dns ──

model GeoDnsConfig {
  id        String   @id @default(cuid())
  orgId     String   @unique
  enabled   Boolean  @default(false)
  zone      String   @default("")
  ttl       Int      @default(30)
  provider  String   @default("coredns")
  /** GeoLite2 + provider-sync REFERENCES only (Docker config/secret names, provider
   *  zone id + token-env), never secret values. Parsed by parseGeoDnsSettings(). */
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("geo_dns_config")
}

model DnsRecord {
  id            String   @id @default(cuid())
  orgId         String
  host          String
  region        String
  targetIngress String
  healthy       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, host, region])
  @@index([orgId])
  @@map("dns_record")
}

// ───────────────────────────────────────────── public API keys ──

model ApiKey {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  keyHash     String    @unique
  prefix      String
  scopes      Json      @default("[\"read\"]")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdById String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([prefix])
  @@map("api_key")
}

// ───────────────────────────────────── OAuth2 client-credentials (public-api) ──

model OAuthClient {
  id               String    @id @default(cuid())
  orgId            String
  name             String
  clientId         String    @unique
  clientSecretHash String
  scopes           Json      @default("[\"read\"]")
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  revokedAt        DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("oauth_client")
}

// ─────────────────────────────────────── outbound webhooks (public-api P2) ──

model WebhookEndpoint {
  id        String   @id @default(cuid())
  orgId     String
  url       String
  secret    String // encrypted at rest (@swarmy/core/crypto)
  events    Json     @default("[]")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([orgId])
  @@map("webhook_endpoint")
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  orgId         String
  endpointId    String
  eventType     String
  payload       Json
  status        String    @default("pending") // pending | delivered | failed
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([endpointId])
  @@index([status, nextAttemptAt])
  @@map("webhook_delivery")
}

// ───────────────────────────────────────────── controller backup (data-store) ──

model ControllerBackupConfig {
  id                    String    @id @default("controller")
  targetId              String?
  enabled               Boolean   @default(false)
  schedule              String    @default("0 3 * * *")
  retention             Json      @default("{\"keepDaily\":7,\"keepWeekly\":4,\"keepMonthly\":3}")
  restorePassphraseRef  String?
  restorePassphraseHint String?
  lastRunAt             DateTime?
  nextRunAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  target BackupTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)

  @@map("controller_backup_config")
}

model ControllerSnapshot {
  id               String         @id @default(cuid())
  targetId         String
  resticSnapshotId String?
  sizeBytes        BigInt?
  durationMs       Int?
  manifestJson     Json?
  status           SnapshotStatus @default(RUNNING)
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?
  error            String?        @db.Text

  target BackupTarget @relation("ControllerSnapshots", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([startedAt])
  @@index([targetId])
  @@map("controller_snapshot")
}

// ───────────────────────────────────────────── replicated store / CSI / scheduler (volumes-dr P2) ──

enum StorageClusterDriver {
  GARAGE
  MINIO
  NONE
}

enum ClusterVolumeStatus {
  PROVISIONING
  READY
  FAILED
}

enum BackupJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum RestoreStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model StorageCluster {
  id                String               @id @default(cuid())
  orgId             String               @unique
  driver            StorageClusterDriver @default(NONE)
  enabled           Boolean              @default(false)
  replicationFactor Int                  @default(3)
  region            String               @default("swarmy")
  memberNodeIds     Json                 @default("[]")
  layout            Json                 @default("{}")
  rpcSecretRef      String?
  adminTokenRef     String?
  accessKeyRef      String?
  secretKeyRef      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("storage_cluster")
}

model ClusterVolume {
  id            String              @id @default(cuid())
  orgId         String
  name          String
  csiDriver     String
  accessMode    String              @default("single-writer")
  capacityBytes BigInt?
  options       Json                @default("{}")
  status        ClusterVolumeStatus @default(PROVISIONING)
  serviceId     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
  @@map("cluster_volume")
}

model BackupSchedule {
  id        String    @id @default(cuid())
  orgId     String
  targetId  String
  volume    String
  nodeId    String?
  every     Int
  unit      String
  paused    Boolean   @default(false)
  lastRunAt DateTime?
  nextRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  target BackupTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  jobs   BackupJob[]

  @@index([orgId])
  @@index([paused, nextRunAt])
  @@map("backup_schedule")
}

model BackupJob {
  id         String          @id @default(cuid())
  orgId      String
  scheduleId String?
  snapshotId String?
  status     BackupJobStatus @default(RUNNING)
  error      String?         @db.Text
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  schedule BackupSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@map("backup_job")
}

model RestoreOperation {
  id            String        @id @default(cuid())
  orgId         String
  snapshotId    String
  targetVolume  String
  targetNodeId  String?
  conflict      String        @default("overwrite")
  status        RestoreStatus @default(QUEUED)
  reason        String        @default("manual")
  bytesRestored BigInt?
  error         String?       @db.Text
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([orgId, snapshotId, status])
  @@map("restore_operation")
}

// ───────────────────────────────────────────── mesh routes / ACLs (mesh P2) ──

model MeshRoute {
  id              String    @id @default(cuid())
  orgId           String
  kind            String    @default("direct")
  targetServiceId String?
  targetStackId   String?
  cidr            String?
  port            Int?
  proto           String?
  principalType   String    @default("peer")
  principalId     String
  policyRef       String?
  expiresAt       DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  acls MeshAcl[]

  @@index([orgId])
  @@map("mesh_route")
}

model MeshAcl {
  id        String    @id @default(cuid())
  orgId     String
  routeId   String
  driver    String
  kind      String
  rendered  Json      @default("{}")
  appliedAt DateTime?
  createdAt DateTime  @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  route MeshRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([routeId])
  @@map("mesh_acl")
}

// ───────────────────────────────────────────── ingress tunnels (ingress P2) ──

model Tunnel {
  id             String   @id @default(cuid())
  orgId          String
  provider       String   @default("cloudflare")
  externalId     String?
  name           String
  status         String   @default("pending")
  credentialRef  String?
  tunnelTokenRef String?
  settings       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("tunnel")
}

// ─────────────────────────────────────── terminal sessions (terminal P2) ──

model TerminalPolicy {
  orgId                       String   @id
  containerExecEnabled        Boolean  @default(true)
  nodeShellEnabled            Boolean  @default(false)
  requireMfa                  Boolean  @default(true)
  requireApprovalForNodeShell Boolean  @default(true)
  recordContainerExec         Boolean  @default(true)
  idleTimeoutMs               Int      @default(300000)
  maxSessionMs                Int      @default(3600000)
  allowedRoles                Json     @default("[\"owner\",\"admin\"]")
  updatedAt                   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("terminal_policy")
}

model TerminalSession {
  id           String    @id @default(cuid())
  orgId        String
  actorId      String
  nodeId       String
  targetKind   String
  containerId  String?
  command      Json      @default("{}")
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  exitCode     Int?
  reason       String?
  recordingRef String?
  bytesIn      Int       @default(0)
  bytesOut     Int       @default(0)
  clientIp     String?
  approvedById String?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([actorId])
  @@map("terminal_session")
}

model TerminalApproval {
  id            String   @id @default(cuid())
  orgId         String
  requestedById String
  nodeId        String
  reason        String
  status        String   @default("pending")
  approvedById  String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([requestedById, nodeId])
  @@map("terminal_approval")
}

// ──────────────────────────────────── swarm membership (node-onboarding P2) ──

model IdempotencyKey {
  id           String   @id @default(cuid())
  orgId        String
  key          String
  method       String
  path         String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@map("idempotency_key")
}

model SwarmConfig {
  orgId                String   @id
  swarmId              String?
  managerNodeId        String?
  managerAddr          String?
  // Docker join tokens (`SWMTKN-…`), stored encrypted by the swarm service.
  workerJoinTokenEnc   String?
  managerJoinTokenEnc  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("swarm_config")
}

// ───────────────────────────────────── canvas layout (applications-canvas redesign) ──

model CanvasLayout {
  orgId     String   @id
  // serviceId/stackId → { x, y } persisted node positions (drag = visual only).
  positions Json     @default("{}")
  // last { x, y, zoom } viewport so the canvas reopens where the user left it.
  viewport  Json?
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("canvas_layout")
}
