// swarmy telemetry.db: high-churn, rebuildable samples kept out of control.db
// so they never bloat the control-plane file, its backups or its replica.
// No foreign keys into control.db (a different file): orgId/nodeId are plain
// strings, and rows for a deleted org or node age out with retention.

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated-telemetry"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

enum MetricScope {
  NODE
  CONTAINER
}

model MetricSample {
  id             Int         @id @default(autoincrement())
  orgId          String
  nodeId         String
  scope          MetricScope
  containerId    String?
  serviceId      String?
  cpuPercent     Float
  memUsedBytes   BigInt
  memTotalBytes  BigInt
  netRxBytes     BigInt
  netTxBytes     BigInt
  diskUsedBytes  BigInt
  diskTotalBytes BigInt
  ts             DateTime

  @@index([nodeId, ts])
  @@index([scope, containerId, ts])
  @@index([orgId, ts])
  @@map("metric_sample")
}

// Per-edge request counts (Q4), 5-minute rollups kept 7 days. Written by the
// controller's edge-traffic worker from its in-memory 1-minute ring; pruned
// by the same worker. `host = ''` is the coverage marker: the edge reported
// during this bucket (so a quiet bucket reads 0, not "no data"). `region` and
// `app` are resolved at write time (null app = the "other" bucket: a host
// that is no app's route).
model EdgeTrafficRollup {
  id          Int      @id @default(autoincrement())
  orgId       String
  nodeId      String
  region      String?
  host        String
  app         String?
  bucketStart DateTime
  requests    Int
  errors5xx   Int

  @@unique([orgId, nodeId, host, bucketStart])
  @@index([orgId, bucketStart])
  @@index([bucketStart])
  @@map("edge_traffic_rollup")
}

// Managed Postgres slow queries over 24 h (studio insights). pg_stat_statements
// is cumulative, so the pg-slow-queries worker snapshots it every ~5 minutes
// (the studio's bounded, audited system read) and keeps one row per statement
// per snapshot holding the DELTA since the previous one. Pruned with the
// metric samples (METRICS_RETENTION_DAYS). `target` = the studio target (the
// managed cluster name); `queryId` = pg_stat_statements' queryid.
model PgQuerySample {
  id      Int      @id @default(autoincrement())
  orgId   String
  stack   String
  target  String
  queryId String
  calls   Int
  totalMs Float
  rows    Int
  ts      DateTime

  @@index([orgId, stack, target, ts])
  @@index([ts])
  @@map("pg_query_sample")
}

// The normalized statement text for a queryId (literals are already `$n`),
// kept once per statement rather than on every sample.
model PgQueryText {
  id       Int      @id @default(autoincrement())
  orgId    String
  stack    String
  target   String
  queryId  String
  query    String
  lastSeen DateTime

  @@unique([orgId, stack, target, queryId])
  @@index([lastSeen])
  @@map("pg_query_text")
}

// Managed data history: a few numbers per cache, queue and bucket, one row
// per resource per 5-minute bucket, kept 7 days (the hourly retention worker
// prunes them). Written by the reconcile workers that already read these
// numbers (cache INFO, the BullMQ studio sampler, Garage bucket info). The
// unique key is the "one row per resource per bucket" rule: writes upsert,
// so a restart never doubles a bucket. Rows key on names (stack/cluster/
// queue, the Garage bucket id), not on control.db ids.

// A managed cache primary's INFO, the first sample in each bucket. `hits` and
// `misses` are the engine's cumulative keyspace counters; the read diffs
// consecutive rows (a drop is a restart, and that interval is skipped).
model CacheStatSample {
  id              Int      @id @default(autoincrement())
  orgId           String
  stack           String
  cluster         String
  bucketStart     DateTime
  hits            BigInt
  misses          BigInt
  opsPerSec       Int
  usedMemoryBytes BigInt

  @@unique([orgId, stack, cluster, bucketStart])
  @@index([bucketStart])
  @@map("cache_stat_sample")
}

// One BullMQ queue on a managed cache (`stack`/`cluster` = the cache): the
// bucket's last depth reading, the jobs that finished during it (from the
// events stream; null = not measured, never a zero) and the worker copies
// running (null = no worker definition consumes it).
model QueueStatSample {
  id          Int      @id @default(autoincrement())
  orgId       String
  stack       String
  cluster     String
  prefix      String
  queue       String
  bucketStart DateTime
  waiting     Int
  active      Int
  completed   Int?
  failed      Int?
  workers     Int?

  @@unique([orgId, stack, cluster, prefix, queue, bucketStart])
  @@index([bucketStart])
  @@map("queue_stat_sample")
}

// One Garage bucket's size, the first sample in each bucket.
model BucketStatSample {
  id          Int      @id @default(autoincrement())
  orgId       String
  bucketId    String
  bucketStart DateTime
  bytes       BigInt
  objects     Int

  @@unique([orgId, bucketId, bucketStart])
  @@index([bucketStart])
  @@map("bucket_stat_sample")
}
