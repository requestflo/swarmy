{
  "name": "@swarmy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "db:generate": "prisma generate && prisma generate --config prisma.telemetry.config.ts",
    "build": "prisma generate && prisma generate --config prisma.telemetry.config.ts",
    "typecheck": "tsc --noEmit",
    "db:migration": "bun scripts/migration.ts",
    "db:check": "bun scripts/migration.ts --check",
    "db:studio": "prisma studio",
    "test": "bun test",
    "clean": "rm -rf dist .turbo src/generated src/generated-telemetry"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "@prisma/driver-adapter-utils": "^7.0.0"
  },
  "devDependencies": {
    "prisma": "^7.0.0",
    "typescript": "^5.5.4"
  }
}
