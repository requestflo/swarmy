{
  "name": "@swarmy/rum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./build": {
      "types": "./src/build.ts",
      "import": "./src/build.ts"
    }
  },
  "scripts": {
    "build": "echo '@swarmy/rum resolves to src (browser bundles are built on demand by ./build)'",
    "bundle": "bun run src/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@rrweb/record": "2.1.6",
    "mmdb-lib": "^2.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.4"
  }
}
