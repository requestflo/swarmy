{
  "name": "swarmy",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "predev": "kill-port 3001 3003 4000 || true",
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter=@swarmy/app --filter=@swarmy/api",
    "dev:web": "turbo run dev --filter=@swarmy/web",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:agent": "bash scripts/run-agent.sh",
    "dev:vms": "bash scripts/local-vms.sh",
    "build:agent-bin": "bun run scripts/build-agent-binaries.ts",
    "mint-token": "bun --env-file=.env run scripts/mint-token.ts",
    "seed-dev": "bun --env-file=.env run scripts/seed-dev.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "openapi:dump": "bun run --filter @swarmy/api-rest openapi:dump",
    "gen:sdks": "bun run scripts/gen-sdks.ts",
    "db:generate": "turbo run db:generate",
    "db:push": "bun --env-file=.env --filter @swarmy/db db:push",
    "db:migrate": "bun --env-file=.env --filter @swarmy/db db:migrate",
    "db:studio": "bun --env-file=.env --filter @swarmy/db db:studio",
    "docker:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "release": "semantic-release",
    "commitlint": "commitlint --edit",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@swarmy/auth": "workspace:*",
    "@swarmy/core": "workspace:*",
    "@swarmy/db": "workspace:*",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "latest",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "kill-port": "^2.0.1",
    "prettier": "^3.4.2",
    "semantic-release": "^24.2.1",
    "turbo": "^2.3.3",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
