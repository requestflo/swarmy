{
  "name": "@swarmy/dns-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev-dns": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "bun test"
  },
  "dependencies": {
    "@swarmy/core": "workspace:*",
    "@swarmy/dns": "workspace:*",
    "dns-packet": "^5.6.1",
    "mmdb-lib": "^2.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dns-packet": "^5.6.5",
    "typescript": "^5.5.4"
  }
}
