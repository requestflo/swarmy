# Static server for the dashboard's public demo (dist/demo → /srv).
# TLS is terminated by swarmy's edge in front of this container.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Hashed build assets never change; the SPA shell always revalidates.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The demo never talks to a server: the page may only fetch its own files.
		Content-Security-Policy "connect-src 'self'; frame-ancestors 'none'"
		-Server
	}

	# There is no controller behind the demo. Answer its paths with a plain 404
	# rather than the SPA shell, so nothing mistakes this for a real API.
	@controller path /api/* /term/* /agent/* /install /install/* /install.sh /_app-auth/* /status/*
	handle @controller {
		respond "This is the swarmy demo: there is no controller here." 404
	}

	# A missing hashed asset is a 404, never the SPA shell cached as immutable.
	handle /assets/* {
		file_server
	}

	# Client-side routes: every unknown path loads the SPA.
	handle {
		try_files {path} /index.html
		file_server
	}
}
