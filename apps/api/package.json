{
  "name": "@swarmy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@swarmy/auth": "workspace:*",
    "@swarmy/core": "workspace:*",
    "@swarmy/db": "workspace:*",
    "@swarmy/ingress": "workspace:*",
    "@swarmy/trpc": "workspace:*",
    "@trpc/server": "^11.0.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.4"
  }
}
