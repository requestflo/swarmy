# Static server for the prerendered site (dist/client → /srv).
# TLS is terminated by swarmy's edge in front of this container.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Hashed build assets never change; everything else revalidates.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "public, max-age=300"

	# Extensionless prerendered JSON (the docs search index).
	@search path /api/search
	header @search Content-Type "application/json; charset=utf-8"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	try_files {path} {path}/index.html {path}.html
	file_server

	handle_errors 404 {
		rewrite * /404/index.html
		file_server
	}
}
