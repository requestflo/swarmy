{
  "name": "@swarmy/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@swarmy/core": "workspace:*",
    "@swarmy/mesh": "workspace:*",
    "dockerode": "^4.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dockerode": "^3.3.31",
    "typescript": "^5.5.4"
  }
}
